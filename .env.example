# Nexora Editor runtime configuration
# Keep secrets out of source control. Configure production secrets in the hosting provider.

# AI provider
GEMINI_API_KEY=""
NEXORA_AI_MODEL="gemini-3.7-flash"
NEXORA_AI_TEMPERATURE_ASSISTANT="0.4"
NEXORA_AI_TEMPERATURE_AGENT="0.2"
NEXORA_AI_USER_AGENT="Nexora-Editor"

# Server
NEXORA_PORT="3000"
NEXORA_HOST="0.0.0.0"
NEXORA_BODY_LIMIT="50mb"
NEXORA_NODE_ENV="development"

# Deployment CLI commands
NEXORA_VERCEL_CLI_COMMAND="npx vercel --prod"
NEXORA_NETLIFY_CLI_COMMAND="npx netlify deploy --prod --dir=."
NEXORA_CLOUDFLARE_CLI_COMMAND="npx wrangler pages deploy . --project-name <project-name>"
NEXORA_STATIC_PREVIEW_COMMAND="npx serve ."
NEXORA_STATIC_README_FILE="README.md"

# Application
VITE_APP_NAME="Nexora Editor"
VITE_API_BASE_URL=""
VITE_API_PREFIX="/api"
VITE_AI_ASSISTANT_PATH="/api/ai/assistant"
VITE_AI_AGENT_PATH="/api/ai/agent"
VITE_DEPLOY_VALIDATION_PATH="/api/deploy/validate"
VITE_REQUEST_TIMEOUT_MS="120000"
VITE_CLIPBOARD_RESET_MS="2000"

# Supabase (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Development tooling
DISABLE_HMR="false"
